{
  "name": "dsh-echocat-prettier",
  "version": "0.23.5",
  "description": "EchoCat Prettier：为 DSH AI 回复提供多风格排版、emoji、主题表情包与长回复性能保护。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/20260925_GPT安装卸载与验收说明_V2.3.5.md",
    "docs/20260925_GPT新版DSH侧边栏兼容报告_V2.3.5.md"
  ],
  "license": "MIT",
  "author": "VDERR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VDERR/dsh-echocat-prettier.git"
  },
  "homepage": "https://github.com/VDERR/dsh-echocat-prettier#readme",
  "bugs": {
    "url": "https://github.com/VDERR/dsh-echocat-prettier/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "dsh-desktop",
    "chat-ui",
    "theme",
    "chinese"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "npm run build && npm test && npm run test:browser",
    "test:standalone": "node scripts/standalone-test.mjs",
    "test:long": "node scripts/browser-long-answer-test.mjs",
    "test:final": "node scripts/browser-final-test.mjs",
    "package:final": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "devDependencies": {
    "@shikijs/langs": "4.3.1",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "katex": "0.16.47",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "puppeteer-core": "^25.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.3.1",
    "simple-icons": "16.31.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "external": [
        "react"
      ]
    }
  }
}
